{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "harmonies": {
          "minimum": 0,
          "title": "Harmonies",
          "type": "integer"
        },
        "hintsBySeverity": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "title": "Hintsbyseverity",
          "type": "object"
        },
        "lyrics": {
          "minimum": 0,
          "title": "Lyrics",
          "type": "integer"
        },
        "measures": {
          "minimum": 0,
          "title": "Measures",
          "type": "integer"
        },
        "staves": {
          "minimum": 0,
          "title": "Staves",
          "type": "integer"
        },
        "systems": {
          "minimum": 0,
          "title": "Systems",
          "type": "integer"
        }
      },
      "required": [
        "systems",
        "staves",
        "measures",
        "events",
        "harmonies",
        "lyrics",
        "hintsBySeverity"
      ],
      "title": "Counts",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "severity"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EngineInfo": {
      "additionalProperties": false,
      "properties": {
        "buildDigest": {
          "title": "Builddigest",
          "type": "string"
        },
        "gitSha": {
          "title": "Gitsha",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "gitSha",
        "buildDigest"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "InputPage": {
      "additionalProperties": false,
      "properties": {
        "bytesSha256": {
          "title": "Bytessha256",
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "pageIndex": {
          "minimum": 0,
          "title": "Pageindex",
          "type": "integer"
        },
        "rasterDpi": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rasterdpi"
        },
        "sourceKind": {
          "enum": [
            "image",
            "pdf"
          ],
          "title": "Sourcekind",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "pageIndex",
        "bytesSha256",
        "width",
        "height",
        "sourceKind"
      ],
      "title": "InputPage",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "QualityReport": {
      "additionalProperties": false,
      "properties": {
        "blurBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Blurbp",
          "type": "integer"
        },
        "contrastBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Contrastbp",
          "type": "integer"
        },
        "cropRiskBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Cropriskbp",
          "type": "integer"
        },
        "estimatedStaffSpacePixels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedstaffspacepixels"
        },
        "expectedBurdenBucket": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedburdenbucket"
        },
        "glareBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Glarebp",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interlineSpreadBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Interlinespreadbp",
          "type": "integer"
        },
        "jpegQualityEstimate": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jpegqualityestimate"
        },
        "noiseBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Noisebp",
          "type": "integer"
        },
        "perspectiveBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Perspectivebp",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema": {
          "enum": [
            "clavis-ir-0.1",
            "clavis-ir-0.1.1"
          ],
          "title": "Schema",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "retake"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "blurBp",
        "perspectiveBp",
        "glareBp",
        "cropRiskBp",
        "status",
        "reasons",
        "contrastBp",
        "noiseBp",
        "interlineSpreadBp"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "ReportInput": {
      "additionalProperties": false,
      "properties": {
        "pages": {
          "items": {
            "$ref": "#/$defs/InputPage"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "pages"
      ],
      "title": "ReportInput",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "measure",
            "measureStart",
            "measureEnd",
            "harmony",
            "lyric",
            "text",
            "flow"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configDigest": {
      "title": "Configdigest",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EngineInfo"
    },
    "errorCode": {
      "anyOf": [
        {
          "enum": [
            "CLAVIS_INPUT_UNSUPPORTED",
            "CLAVIS_INPUT_CORRUPT",
            "CLAVIS_INPUT_TOO_LARGE",
            "CLAVIS_QUALITY_RETAKE",
            "CLAVIS_NO_STAFF_FOUND",
            "CLAVIS_OOD",
            "CLAVIS_OUTPUT_INCOMPLETE",
            "CLAVIS_OUTPUT_BLOCKED",
            "CLAVIS_RESOURCE_LIMIT",
            "CLAVIS_TIMEOUT",
            "CLAVIS_CANCELLED",
            "CLAVIS_INTERNAL"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorcode"
    },
    "input": {
      "$ref": "#/$defs/ReportInput"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelInfo"
      },
      "title": "Models",
      "type": "array"
    },
    "quality": {
      "items": {
        "$ref": "#/$defs/QualityReport"
      },
      "title": "Quality",
      "type": "array"
    },
    "schema": {
      "const": "clavis-report-0.1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "engine",
    "models",
    "configDigest",
    "input",
    "quality",
    "status",
    "counts",
    "diagnostics"
  ],
  "title": "Report",
  "type": "object"
}
