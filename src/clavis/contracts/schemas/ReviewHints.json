    "AccidentalPatch": {
      "additionalProperties": false,
      "properties": {
        "alter": {
          "maximum": 2,
          "minimum": -2,
          "title": "Alter",
          "type": "integer"
        },
        "kind": {
          "const": "accidental",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "alter"
      ],
      "title": "AccidentalPatch",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "alternativeId": {
          "minLength": 1,
          "title": "Alternativeid",
          "type": "string"
