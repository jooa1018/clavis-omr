      "additionalProperties": false,
      "properties": {
        "alter": {
          "maximum": 2,
          "minimum": -2,
          "title": "Alter",
          "type": "integer"
        },
        "type": {
          "enum": [
            "add",
            "alter",
            "subtract"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "alter",
