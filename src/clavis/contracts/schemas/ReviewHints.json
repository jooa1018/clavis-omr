            "$ref": "#/$defs/Degree"
          },
          "title": "Degrees",
          "type": "array"
        },
        "kind": {
          "enum": [
            "major",
            "minor",
            "augmented",
            "diminished",
            "dominant",
            "major-seventh",
            "minor-seventh",
            "diminished-seventh",
            "half-diminished",
            "major-minor",
            "major-sixth",
            "minor-sixth",
            "dominant-ninth",
            "major-ninth",
            "minor-ninth",
            "dominant-11th",
            "dominant-13th",
            "suspended-second",
            "suspended-fourth",
            "power",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "kindText": {
          "title": "Kindtext",
          "type": "string"
        },
        "normalized": {
          "title": "Normalized",
          "type": "string"
        },
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/PitchClass"
            },
            {
              "type": "null"
