        "confidenceBp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Confidencebp",
          "type": "integer"
        },
        "labelKo": {
          "title": "Labelko",
          "type": "string"
        },
        "patch": {
          "discriminator": {
            "mapping": {
              "accidental": "#/$defs/AccidentalPatch",
              "chord": "#/$defs/ChordPatch",
              "deleteBarline": "#/$defs/DeleteBarlinePatch",
              "duration": "#/$defs/DurationPatch",
              "insertBarline": "#/$defs/InsertBarlinePatch",
              "keySignature": "#/$defs/KeySignaturePatch",
              "pitch": "#/$defs/PitchPatch",
              "replaceEvent": "#/$defs/ReplaceEventPatch",
              "replaceSourceText": "#/$defs/ReplaceSourceTextPatch",
              "tie": "#/$defs/TiePatch",
              "timeSignature": "#/$defs/TimeSignaturePatch"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PitchPatch"
            },
            {
              "$ref": "#/$defs/DurationPatch"
            },
            {
              "$ref": "#/$defs/AccidentalPatch"
            },
            {
              "$ref": "#/$defs/TiePatch"
            },
            {
              "$ref": "#/$defs/ChordPatch"
            },
            {
              "$ref": "#/$defs/TimeSignaturePatch"
            },
            {
              "$ref": "#/$defs/KeySignaturePatch"
            },
            {
              "$ref": "#/$defs/ReplaceEventPatch"
            },
            {
              "$ref": "#/$defs/ReplaceSourceTextPatch"
            },
            {
              "$ref": "#/$defs/InsertBarlinePatch"
            },
            {
              "$ref": "#/$defs/DeleteBarlinePatch"
            }
          ],
          "title": "Patch"
        }
      },
      "required": [
        "alternativeId",
        "labelKo",
        "patch",
        "confidenceBp"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "ChordParseResult": {
